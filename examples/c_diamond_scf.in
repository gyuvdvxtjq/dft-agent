&CONTROL
calculation='scf'
pseudo_dir='{job_dir}'
outdir='/tmp/s'
/
&SYSTEM
ibrav=2
celldm(1)=6.67
nat=2
ntyp=1
ecutwfc=40
ecutrho=160
/
&ELECTRONS
conv_thr=1e-6
electron_maxstep=100
mixing_beta=0.7
/
ATOMIC_SPECIES
C 12.011 C.UPF
ATOMIC_POSITIONS alat
C 0 0 0
C .25 .25 .25
K_POINTS automatic
2 2 2 0 0 0
