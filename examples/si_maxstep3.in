&CONTROL
calculation='scf'
pseudo_dir='/root'
outdir='/tmp/s'
/
&SYSTEM
ibrav=2
celldm(1)=10.2
nat=2
ntyp=1
ecutwfc=30
ecutrho=120
/
&ELECTRONS
conv_thr=1e-6
electron_maxstep=3
mixing_beta=0.9
/
ATOMIC_SPECIES
Si 28.0855 Si_r.upf
ATOMIC_POSITIONS alat
Si 0 0 0
Si .25 .25 .25
K_POINTS automatic
2 2 2 0 0 0
